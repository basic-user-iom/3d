{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "files": [
    "src/viewer/viewerLoadSession.ts",
    "src/viewer/utils/disposeObject3D.ts",
    "src/viewer/loaders/scopedLoadingSession.ts",
    "src/viewer/loaders/blobUrlRegistry.ts",
    "src/utils/hotspotContentSafety.ts",
    "src/panorama/panoramaAnimationLoop.ts",
    "src/viewer/utils/modelAnimations.ts",
    "src/viewer/utils/renderLoopIdle.ts",
    "src/utils/objectsPanelTreeStats.ts"
  ]
}
